#!/bin/bash
#
# azvm-working - Azure VM Management Tool with Bastion Support
# Enhanced version with comprehensive VM management and secure Bastion connectivity
#

set -e

# Configuration
DEFAULT_VM_SIZE="Standard_D4as_v5"
DEFAULT_LOCATION="southeastasia"
DEFAULT_IMAGE="canonical:ubuntu-24_04-lts:ubuntu-pro:latest"
DEFAULT_DISK_SIZE="512"
DEFAULT_STORAGE_TYPE="StandardSSD_LRS"
DEFAULT_ADMIN_USER="setuc"
DEFAULT_SSH_KEY_PATH="$HOME/.ssh/id_ed25519.pub"
SSH_CONFIG_FILE="$HOME/.ssh/config"

# Bastion Configuration
BASE_LOCAL_PORT=2200
TUNNEL_DIR="$HOME/.azure/bastion-tunnels"
LOG_DIR="$HOME/.azure/logs"
MAX_RECONNECT_ATTEMPTS=3
RECONNECT_DELAY=5

# Create necessary directories
mkdir -p "$TUNNEL_DIR" "$LOG_DIR"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Print functions
print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Show help
show_help() {
    cat << EOF
Azure VM Management Tool with Bastion Support

Usage: $0 <command> [OPTIONS]

Commands:
    create      Create a new Azure VM
    delete      Delete an Azure VM and its resources
    list        List all VMs with details
    status      Show detailed status of a VM
    start       Start a stopped VM
    stop        Stop a running VM
    connect     Connect to VM via Bastion SSH tunnel
    tunnel      Manage Bastion tunnels (list/kill)
    bastion     Deploy Bastion to existing VM's resource group

Create Options:
    --name <name>           VM name (required)
    --size <size>           VM size (default: $DEFAULT_VM_SIZE)
    --location <location>   Azure location (default: $DEFAULT_LOCATION)
    --disk-size <size>      OS disk size in GB (default: $DEFAULT_DISK_SIZE)
    --new-key               Create a new SSH key for this VM
    --no-restrict-ssh       Skip SSH access restriction
    --enable-bastion        Deploy Bastion for secure access
    --help                  Show this help message

Delete Options:
    --name <name>           VM name (required)
    --force                 Skip confirmation prompt
    --keep-resources        Keep resource group and other resources
    --help                  Show this help message

Connect Options:
    --name <name>           VM name (required)
    --port <port>           Local port for tunnel (default: auto)
    --resource-id <id>      Use resource ID instead of name
    --auto-reconnect        Enable automatic reconnection
    --help                  Show this help message

Tunnel Options:
    list                    List active Bastion tunnels
    kill <pid|port|all>     Kill specific tunnel or all tunnels
    status                  Check tunnel health status

Bastion Options:
    --name <name>           VM name (required)
    --help                  Show this help message

Examples:
    $0 create --name myvm --enable-bastion
    $0 list
    $0 status --name myvm
    $0 bastion --name existingvm
    $0 connect --name myvm --auto-reconnect
    $0 tunnel list
    $0 tunnel kill 2222
EOF
}

# Create SSH key
create_ssh_key() {
    local vm_name=$1
    local key_path="$HOME/.ssh/id_ed25519_${vm_name}"
    
    if [[ -f "$key_path" ]]; then
        print_warning "SSH key already exists: $key_path"
        read -p "Do you want to overwrite it? (y/N): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "$key_path.pub"
            return 0
        fi
    fi
    
    print_status "Creating new SSH key: $key_path"
    ssh-keygen -t ed25519 -f "$key_path" -N "" -C "azure-vm-$vm_name"
    echo "$key_path.pub"
}

# Check if SSH key exists
check_ssh_key() {
    local key_path=$1
    if [[ ! -f "$key_path" ]]; then
        print_error "SSH key not found: $key_path"
        print_status "You can:"
        print_status "  1. Create default key: ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519"
        print_status "  2. Use --new-key option to create a VM-specific key"
        exit 1
    fi
}

# Add VM to SSH config
add_to_ssh_config() {
    local vm_name=$1
    local public_ip=$2
    local ssh_key_path=$3
    local username=$4
    
    print_status "Adding VM to SSH config..."
    
    # Remove existing entry if it exists
    if grep -q "Host $vm_name" "$SSH_CONFIG_FILE" 2>/dev/null; then
        print_warning "Removing existing SSH config entry for $vm_name"
        sed -i "/Host $vm_name/,/^$/d" "$SSH_CONFIG_FILE"
    fi
    
    # Add new entry
    cat >> "$SSH_CONFIG_FILE" << EOF

Host $vm_name
    HostName $public_ip
    User $username
    IdentityFile ${ssh_key_path%.pub}
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    ConnectTimeout 10

EOF
    
    print_success "Added $vm_name to SSH config. You can now connect with: ssh $vm_name"
}

# Wait for VM to be ready for SSH
wait_for_ssh() {
    local vm_name=$1
    local max_attempts=30
    local attempt=1
    
    print_status "Waiting for VM to be ready for SSH connection..."
    
    while [[ $attempt -le $max_attempts ]]; do
        if ssh -o ConnectTimeout=5 -o BatchMode=yes "$vm_name" "echo 'SSH ready'" >/dev/null 2>&1; then
            print_success "VM is ready for SSH connection"
            return 0
        fi
        
        print_status "Attempt $attempt/$max_attempts: VM not ready yet, waiting 10 seconds..."
        sleep 10
        ((attempt++))
    done
    
    print_error "VM did not become ready for SSH within expected time"
    return 1
}

# Restrict SSH access
restrict_ssh_access() {
    local vm_name=$1
    local resource_group=$2
    
    print_status "Getting your source IP address from the VM..."
    
    # Get the source IP from SSH_CONNECTION variable on the VM
    local source_ip
    source_ip=$(ssh "$vm_name" "echo \$SSH_CONNECTION | cut -d' ' -f1" 2>/dev/null)
    
    if [[ -z "$source_ip" ]]; then
        print_error "Failed to retrieve source IP address from VM"
        return 1
    fi
    
    print_success "Detected source IP: $source_ip"
    
    # Get the network security group name
    local nsg_name
    nsg_name=$(az vm show --resource-group "$resource_group" --name "$vm_name" \
        --query "networkProfile.networkInterfaces[0].id" -o tsv | \
        xargs -I {} az network nic show --ids {} \
        --query "networkSecurityGroup.id" -o tsv | \
        xargs -I {} basename {})
    
    if [[ -z "$nsg_name" ]]; then
        print_warning "Could not find Network Security Group. VM might be using subnet-level NSG."
        print_status "You may need to manually restrict SSH access in the Azure portal"
        return 1
    fi
    
    print_status "Found Network Security Group: $nsg_name"
    print_status "Updating SSH rule to allow access only from $source_ip..."
    
    # Update the SSH rule to only allow access from the source IP
    local rule_exists
    rule_exists=$(az network nsg rule list --resource-group "$resource_group" --nsg-name "$nsg_name" \
        --query "[?name=='SSH' || name=='default-allow-ssh'].name" -o tsv)
    
    if [[ -n "$rule_exists" ]]; then
        # Update existing SSH rule
        local rule_name="$rule_exists"
        print_status "Updating existing SSH rule: $rule_name"
        
        az network nsg rule update \
            --resource-group "$resource_group" \
            --nsg-name "$nsg_name" \
            --name "$rule_name" \
            --source-address-prefixes "$source_ip/32" \
            --output none
    else
        # Create new SSH rule
        print_status "Creating new SSH rule for restricted access"
        
        az network nsg rule create \
            --resource-group "$resource_group" \
            --nsg-name "$nsg_name" \
            --name "SSH-Restricted" \
            --protocol tcp \
            --priority 1000 \
            --destination-port-range 22 \
            --source-address-prefixes "$source_ip/32" \
            --access allow \
            --output none
    fi
    
    print_success "SSH access restricted to your IP address: $source_ip"
    print_warning "Note: If your IP changes, you'll need to update the NSG rule or you'll lose SSH access"
}

# Get delete after date
get_delete_after_date() {
    if command -v date >/dev/null 2>&1; then
        if [[ "$OSTYPE" == "darwin"* ]]; then
            # macOS
            date -v+1y '+%d-%b-%Y'
        else
            # Linux
            date -d '+1 year' '+%d-%b-%Y'
        fi
    else
        echo "31-Dec-2026"
    fi
}

# Main create function
create_vm() {
    local vm_name=""
    local vm_size="$DEFAULT_VM_SIZE"
    local location="$DEFAULT_LOCATION"
    local disk_size="$DEFAULT_DISK_SIZE"
    local new_key=false
    local restrict_ssh=true
    local ssh_key_path="$DEFAULT_SSH_KEY_PATH"
    local enable_bastion=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --name)
                vm_name="$2"
                shift 2
                ;;
            --size)
                vm_size="$2"
                shift 2
                ;;
            --location)
                location="$2"
                shift 2
                ;;
            --disk-size)
                disk_size="$2"
                shift 2
                ;;
            --new-key)
                new_key=true
                shift
                ;;
            --no-restrict-ssh)
                restrict_ssh=false
                shift
                ;;
            --enable-bastion)
                enable_bastion=true
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                print_error "Unknown option: $1"
                show_help
                exit 1
                ;;
        esac
    done
    
    # Validate required arguments
    if [[ -z "$vm_name" ]]; then
        print_error "VM name is required. Use --name <name>"
        show_help
        exit 1
    fi
    
    # Validate VM name format
    if [[ ! "$vm_name" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,63}$ ]]; then
        print_error "VM name must start with alphanumeric character and contain only letters, numbers, and hyphens (max 64 chars)"
        exit 1
    fi
    
    # Set resource group
    local resource_group="${vm_name}_group"
    
    print_status "Starting VM creation process..."
    print_status "VM Name: $vm_name"
    print_status "Resource Group: $resource_group"
    print_status "Location: $location"
    print_status "VM Size: $vm_size"
    
    # Handle SSH key
    if [[ "$new_key" == true ]]; then
        ssh_key_path=$(create_ssh_key "$vm_name")
    else
        check_ssh_key "$ssh_key_path"
    fi
    
    print_status "Using SSH key: $ssh_key_path"
    
    # Check if logged into Azure
    if ! az account show >/dev/null 2>&1; then
        print_error "Not logged into Azure. Please run: az login"
        exit 1
    fi
    
    # Create resource group if it doesn't exist
    print_status "Creating resource group if it doesn't exist..."
    az group create --name "$resource_group" --location "$location" --output none
    
    # Prepare tags
    local delete_after=$(get_delete_after_date)
    local tags="Division=GBB/CSA Environment=Development TimeZone=GMT+8 deleteAfter=$delete_after owner=$USER purpose=Auto-created-VM"
    
    print_status "Creating virtual machine..."
    
    # Create VM
    az vm create \
        --resource-group "$resource_group" \
        --name "$vm_name" \
        --image "$DEFAULT_IMAGE" \
        --admin-username "$DEFAULT_ADMIN_USER" \
        --ssh-key-values "$ssh_key_path" \
        --size "$vm_size" \
        --location "$location" \
        --os-disk-size-gb "$disk_size" \
        --storage-sku "$DEFAULT_STORAGE_TYPE" \
        --boot-diagnostics-storage "" \
        --authentication-type ssh \
        --tags $tags \
        --output none
    
    print_success "VM created successfully!"
    
    # Get public IP
    print_status "Retrieving public IP address..."
    local public_ip=$(az vm show -d -g "$resource_group" -n "$vm_name" --query publicIps -o tsv)
    
    if [[ -z "$public_ip" ]]; then
        print_warning "No public IP found. The VM might not have a public IP assigned."
        restrict_ssh=false
    else
        print_success "Public IP: $public_ip"
        
        # Add to SSH config
        add_to_ssh_config "$vm_name" "$public_ip" "$ssh_key_path" "$DEFAULT_ADMIN_USER"
        
        # Restrict SSH access if requested
        if [[ "$restrict_ssh" == true ]]; then
            print_status "SSH access restriction is enabled"
            
            # Wait for VM to be ready for SSH
            if wait_for_ssh "$vm_name"; then
                # Restrict SSH access to current IP
                restrict_ssh_access "$vm_name" "$resource_group"
            else
                print_warning "Could not establish SSH connection. Skipping SSH access restriction."
            fi
        else
            print_warning "SSH access restriction is disabled. Your VM is accessible from any IP address."
        fi
    fi
    
    # Deploy Bastion if requested
    if [[ "$enable_bastion" == true ]]; then
        print_status "Deploying Azure Bastion for secure access..."
        
        # Get VNet name
        local vnet_name
        vnet_name=$(az network nic show \
            --ids $(az vm show -g "$resource_group" -n "$vm_name" --query "networkProfile.networkInterfaces[0].id" -o tsv) \
            --query "ipConfigurations[0].subnet.id" -o tsv | \
            grep -oP '(?<=virtualNetworks/)[^/]+')
        
        if [[ -z "$vnet_name" ]]; then
            print_warning "Could not determine VNet name. Skipping Bastion deployment."
        else
            # Create AzureBastionSubnet
            print_status "Creating AzureBastionSubnet..."
            az network vnet subnet create \
                --resource-group "$resource_group" \
                --vnet-name "$vnet_name" \
                --name "AzureBastionSubnet" \
                --address-prefixes "10.0.2.0/26" \
                --output none 2>/dev/null || print_warning "AzureBastionSubnet already exists or address conflict"
            
            # Create public IP for Bastion
            local bastion_name="${resource_group}-bastion"
            print_status "Creating public IP for Bastion..."
            az network public-ip create \
                --resource-group "$resource_group" \
                --name "${bastion_name}-pip" \
                --sku Standard \
                --allocation-method Static \
                --output none
            
            # Deploy Bastion
            print_status "Deploying Bastion (this may take 5-10 minutes)..."
            az network bastion create \
                --name "$bastion_name" \
                --resource-group "$resource_group" \
                --vnet-name "$vnet_name" \
                --public-ip-address "${bastion_name}-pip" \
                --sku Standard \
                --enable-tunneling true \
                --enable-ip-connect true \
                --output none
            
            print_success "Bastion deployed successfully!"
            print_status "You can now connect using: $0 connect --name $vm_name"
        fi
    fi
    
    # Show VM details
    print_status "VM Details:"
    az vm show -d -g "$resource_group" -n "$vm_name" --query "{Name:name, PowerState:powerState, PublicIP:publicIps, PrivateIP:privateIps, Size:hardwareProfile.vmSize}" -o table
    
    print_success "VM creation completed!"
    
    if [[ -n "$public_ip" ]]; then
        print_status "Connection: ssh $vm_name"
        if [[ "$restrict_ssh" == true ]]; then
            print_status "Security: SSH access restricted to your current IP"
        else
            print_warning "Security: SSH access is open to all IPs"
        fi
    fi
    
    print_status "Management commands:"
    print_status "  Delete VM: az vm delete --resource-group $resource_group --name $vm_name --yes"
    print_status "  Start VM: az vm start --resource-group $resource_group --name $vm_name"
    print_status "  Stop VM: az vm stop --resource-group $resource_group --name $vm_name"
}

# Remove SSH config entry
remove_from_ssh_config() {
    local vm_name=$1
    
    if grep -q "Host $vm_name" "$SSH_CONFIG_FILE" 2>/dev/null; then
        print_status "Removing SSH config entry for $vm_name..."
        sed -i "/Host $vm_name/,/^$/d" "$SSH_CONFIG_FILE"
        print_success "Removed $vm_name from SSH config"
    else
        print_status "No SSH config entry found for $vm_name"
    fi
}

# Main delete function
delete_vm() {
    local vm_name=""
    local force=false
    local keep_resources=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --name)
                vm_name="$2"
                shift 2
                ;;
            --force)
                force=true
                shift
                ;;
            --keep-resources)
                keep_resources=true
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                print_error "Unknown option: $1"
                show_help
                exit 1
                ;;
        esac
    done
    
    # Validate required arguments
    if [[ -z "$vm_name" ]]; then
        print_error "VM name is required. Use --name <name>"
        show_help
        exit 1
    fi
    
    # Validate VM name format
    if [[ ! "$vm_name" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,63}$ ]]; then
        print_error "VM name must start with alphanumeric character and contain only letters, numbers, and hyphens (max 64 chars)"
        exit 1
    fi
    
    # Set resource group
    local resource_group="${vm_name}_group"
    
    # Check if logged into Azure
    if ! az account show >/dev/null 2>&1; then
        print_error "Not logged into Azure. Please run: az login"
        exit 1
    fi
    
    # Check if VM exists
    print_status "Checking if VM exists..."
    if ! az vm show --resource-group "$resource_group" --name "$vm_name" >/dev/null 2>&1; then
        print_warning "VM '$vm_name' not found in resource group '$resource_group'"
        
        # Check if resource group exists
        if az group show --name "$resource_group" >/dev/null 2>&1; then
            print_status "Resource group '$resource_group' exists but VM not found"
            if [[ "$force" == false ]]; then
                read -p "Do you want to delete the resource group anyway? (y/N): " -n 1 -r
                echo
                if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                    print_status "Deletion cancelled"
                    exit 0
                fi
            fi
        else
            print_status "Neither VM nor resource group found. Nothing to delete."
            exit 0
        fi
    else
        print_success "Found VM '$vm_name' in resource group '$resource_group'"
        
        # Show VM details before deletion
        print_status "VM Details:"
        az vm show -d -g "$resource_group" -n "$vm_name" --query "{Name:name, PowerState:powerState, PublicIP:publicIps, PrivateIP:privateIps, Size:hardwareProfile.vmSize}" -o table
        
        # Confirmation prompt
        if [[ "$force" == false ]]; then
            echo
            print_warning "This will delete the VM and associated resources!"
            if [[ "$keep_resources" == false ]]; then
                print_warning "The entire resource group '$resource_group' will be deleted!"
            fi
            read -p "Are you sure you want to continue? (y/N): " -n 1 -r
            echo
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                print_status "Deletion cancelled"
                exit 0
            fi
        fi
    fi
    
    print_status "Starting deletion process..."
    
    # Remove from SSH config first
    remove_from_ssh_config "$vm_name"
    
    if [[ "$keep_resources" == true ]]; then
        # Delete only the VM
        print_status "Deleting VM '$vm_name'..."
        az vm delete --resource-group "$resource_group" --name "$vm_name" --yes
        print_success "VM '$vm_name' deleted successfully"
        
        print_status "Keeping resource group and other resources as requested"
        print_status "You can manually clean up resources later if needed:"
        print_status "  az group delete --name $resource_group --yes"
    else
        # Delete the entire resource group
        print_status "Deleting resource group '$resource_group' and all resources..."
        az group delete --name "$resource_group" --yes --no-wait
        print_success "Resource group '$resource_group' deletion initiated"
        print_status "Deletion is running in the background and may take a few minutes to complete"
    fi
    
    # Remove VM-specific SSH key if it exists
    local vm_ssh_key="$HOME/.ssh/id_ed25519_${vm_name}"
    if [[ -f "$vm_ssh_key" ]]; then
        if [[ "$force" == false ]]; then
            read -p "Remove VM-specific SSH key '$vm_ssh_key'? (y/N): " -n 1 -r
            echo
            if [[ $REPLY =~ ^[Yy]$ ]]; then
                rm -f "$vm_ssh_key" "$vm_ssh_key.pub"
                print_success "Removed VM-specific SSH key"
            fi
        else
            rm -f "$vm_ssh_key" "$vm_ssh_key.pub"
            print_success "Removed VM-specific SSH key"
        fi
    fi
    
    print_success "VM deletion completed!"
}

# List all VMs with details
list_vms() {
    check_requirements
    
    local format="${1:-table}"
    
    print_status "Fetching Azure VMs..."
    
    if [[ "$format" == "detailed" ]] || [[ "$format" == "-d" ]]; then
        az vm list -d --query "[].{
            Name:name,
            ResourceGroup:resourceGroup,
            Status:powerState,
            Location:location,
            Size:hardwareProfile.vmSize,
            PublicIP:publicIps,
            PrivateIP:privateIps,
            OS:storageProfile.osDisk.osType
        }" -o table
    else
        az vm list -d --query "[].{
            Name:name,
            ResourceGroup:resourceGroup,
            Status:powerState,
            PublicIP:publicIps
        }" -o table
    fi
}

# Get detailed VM status
vm_status() {
    check_requirements
    
    local vm_name=""
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --name)
                vm_name="$2"
                shift 2
                ;;
            --help|-h)
                echo "Usage: $0 status --name <vm_name>"
                exit 0
                ;;
            *)
                print_error "Unknown option: $1"
                exit 1
                ;;
        esac
    done
    
    # Interactive selection if no name provided
    if [[ -z "$vm_name" ]]; then
        local vm_info
        vm_info=$(az vm list -d --query "[].{Name:name,ResourceGroup:resourceGroup,State:powerState}" -o json | \
                  jq -r '.[] | "\(.Name) \(.ResourceGroup) \(.State)"' | \
                  fzf --prompt="Select VM: " --header="NAME RESOURCE_GROUP STATE")
        
        if [[ -n "$vm_info" ]]; then
            vm_name=$(echo "$vm_info" | awk '{print $1}')
        else
            print_error "No VM selected"
            exit 1
        fi
    fi
    
    # Get resource group
    local resource_group
    resource_group=$(az vm list --query "[?name=='$vm_name'].resourceGroup | [0]" -o tsv 2>/dev/null)
    
    if [[ -z "$resource_group" ]]; then
        print_error "VM '$vm_name' not found"
        exit 1
    fi
    
    print_status "VM Details for: $vm_name"
    
    # Get detailed VM information
    az vm show -d --name "$vm_name" --resource-group "$resource_group" \
        --query "{
            Name:name,
            ResourceGroup:resourceGroup,
            Location:location,
            PowerState:powerState,
            ProvisioningState:provisioningState,
            PublicIP:publicIps,
            PrivateIP:privateIps,
            Size:hardwareProfile.vmSize,
            OS:storageProfile.osDisk.osType,
            OSDiskSize:storageProfile.osDisk.diskSizeGb,
            AdminUsername:osProfile.adminUsername
        }" -o yaml
    
    # Check for Bastion availability
    print_status "\nChecking Bastion availability..."
    local bastion_name
    bastion_name=$(az network bastion list --resource-group "$resource_group" \
                   --query "[0].name" -o tsv 2>/dev/null)
    
    if [[ -n "$bastion_name" ]]; then
        print_success "Bastion available: $bastion_name"
        echo "Connection command: $0 connect --name $vm_name"
    else
        print_warning "No Bastion deployed in resource group"
    fi
}

# Start VM
start_vm() {
    check_requirements
    
    local vm_name=""
    local wait=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --name)
                vm_name="$2"
                shift 2
                ;;
            --wait)
                wait=true
                shift
                ;;
            --help|-h)
                echo "Usage: $0 start --name <vm_name> [--wait]"
                exit 0
                ;;
            *)
                print_error "Unknown option: $1"
                exit 1
                ;;
        esac
    done
    
    # Interactive selection if no name provided
    if [[ -z "$vm_name" ]]; then
        local vm_info
        vm_info=$(az vm list -d --query "[?powerState!='VM running'].{Name:name,ResourceGroup:resourceGroup,State:powerState}" -o json | \
                  jq -r '.[] | "\(.Name) \(.ResourceGroup) \(.State)"' | \
                  fzf --prompt="Select VM to start: " --header="NAME RESOURCE_GROUP STATE")
        
        if [[ -n "$vm_info" ]]; then
            vm_name=$(echo "$vm_info" | awk '{print $1}')
        else
            print_error "No VM selected"
            exit 1
        fi
    fi
    
    # Get resource group
    local resource_group
    resource_group=$(az vm list --query "[?name=='$vm_name'].resourceGroup | [0]" -o tsv 2>/dev/null)
    
    if [[ -z "$resource_group" ]]; then
        print_error "VM '$vm_name' not found"
        exit 1
    fi
    
    print_status "Starting VM: $vm_name"
    
    if [[ "$wait" == true ]]; then
        az vm start --name "$vm_name" --resource-group "$resource_group"
        print_success "VM started successfully"
    else
        az vm start --name "$vm_name" --resource-group "$resource_group" --no-wait
        print_success "VM start initiated. Check status with: $0 status --name $vm_name"
    fi
}

# Stop VM
stop_vm() {
    check_requirements
    
    local vm_name=""
    local deallocate=true
    local wait=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --name)
                vm_name="$2"
                shift 2
                ;;
            --no-deallocate)
                deallocate=false
                shift
                ;;
            --wait)
                wait=true
                shift
                ;;
            --help|-h)
                echo "Usage: $0 stop --name <vm_name> [--no-deallocate] [--wait]"
                echo "  --no-deallocate: Stop VM but keep it allocated (will continue billing)"
                exit 0
                ;;
            *)
                print_error "Unknown option: $1"
                exit 1
                ;;
        esac
    done
    
    # Interactive selection if no name provided
    if [[ -z "$vm_name" ]]; then
        local vm_info
        vm_info=$(az vm list -d --query "[?powerState=='VM running'].{Name:name,ResourceGroup:resourceGroup,State:powerState}" -o json | \
                  jq -r '.[] | "\(.Name) \(.ResourceGroup) \(.State)"' | \
                  fzf --prompt="Select VM to stop: " --header="NAME RESOURCE_GROUP STATE")
        
        if [[ -n "$vm_info" ]]; then
            vm_name=$(echo "$vm_info" | awk '{print $1}')
        else
            print_error "No VM selected"
            exit 1
        fi
    fi
    
    # Get resource group
    local resource_group
    resource_group=$(az vm list --query "[?name=='$vm_name'].resourceGroup | [0]" -o tsv 2>/dev/null)
    
    if [[ -z "$resource_group" ]]; then
        print_error "VM '$vm_name' not found"
        exit 1
    fi
    
    if [[ "$deallocate" == true ]]; then
        print_status "Stopping and deallocating VM: $vm_name"
        if [[ "$wait" == true ]]; then
            az vm deallocate --name "$vm_name" --resource-group "$resource_group"
            print_success "VM stopped and deallocated"
        else
            az vm deallocate --name "$vm_name" --resource-group "$resource_group" --no-wait
            print_success "VM deallocation initiated (will not be billed once stopped)"
        fi
    else
        print_status "Stopping VM: $vm_name (keeping allocated)"
        if [[ "$wait" == true ]]; then
            az vm stop --name "$vm_name" --resource-group "$resource_group"
            print_success "VM stopped (still allocated and billing)"
        else
            az vm stop --name "$vm_name" --resource-group "$resource_group" --no-wait
            print_success "VM stop initiated (will continue billing)"
        fi
    fi
}

# Get next available port
get_next_port() {
    local base_port=${1:-$BASE_LOCAL_PORT}
    local port=$base_port
    
    while lsof -i :$port >/dev/null 2>&1; do
        ((port++))
    done
    
    echo $port
}

# Save tunnel info
save_tunnel_info() {
    local vm_name=$1
    local resource_group=$2
    local local_port=$3
    local pid=$4
    
    cat > "$TUNNEL_DIR/${vm_name}.tunnel" << EOF
VM_NAME=$vm_name
RESOURCE_GROUP=$resource_group
LOCAL_PORT=$local_port
PID=$pid
START_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
}

# Load tunnel info
load_tunnel_info() {
    local tunnel_file=$1
    if [[ -f "$tunnel_file" ]]; then
        source "$tunnel_file"
    fi
}

# Check if tunnel is active
is_tunnel_active() {
    local pid=$1
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

# Connect to VM via Bastion
connect_bastion() {
    check_requirements
    
    local vm_name=""
    local resource_id=""
    local local_port=""
    local auto_reconnect=false
    local ssh_after=true
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --name)
                vm_name="$2"
                shift 2
                ;;
            --resource-id)
                resource_id="$2"
                shift 2
                ;;
            --port)
                local_port="$2"
                shift 2
                ;;
            --auto-reconnect)
                auto_reconnect=true
                shift
                ;;
            --no-ssh)
                ssh_after=false
                shift
                ;;
            --help|-h)
                echo "Usage: $0 connect --name <vm_name> [--port <port>] [--auto-reconnect] [--no-ssh]"
                exit 0
                ;;
            *)
                print_error "Unknown option: $1"
                exit 1
                ;;
        esac
    done
    
    # Interactive selection if no name or resource ID provided
    if [[ -z "$vm_name" ]] && [[ -z "$resource_id" ]]; then
        local vm_info
        vm_info=$(az vm list -d --query "[?powerState=='VM running'].{Name:name,ResourceGroup:resourceGroup,PrivateIP:privateIps}" -o json | \
                  jq -r '.[] | "\(.Name) \(.ResourceGroup) \(.PrivateIP)"' | \
                  fzf --prompt="Select VM to connect: " --header="NAME RESOURCE_GROUP PRIVATE_IP")
        
        if [[ -n "$vm_info" ]]; then
            vm_name=$(echo "$vm_info" | awk '{print $1}')
        else
            print_error "No VM selected"
            exit 1
        fi
    fi
    
    # Get VM details if using name
    if [[ -n "$vm_name" ]] && [[ -z "$resource_id" ]]; then
        local resource_group
        resource_group=$(az vm list --query "[?name=='$vm_name'].resourceGroup | [0]" -o tsv 2>/dev/null)
        
        if [[ -z "$resource_group" ]]; then
            print_error "VM '$vm_name' not found"
            exit 1
        fi
        
        # Get resource ID
        resource_id=$(az vm show --name "$vm_name" --resource-group "$resource_group" --query "id" -o tsv)
    fi
    
    # Extract resource group from resource ID if needed
    if [[ -z "$resource_group" ]]; then
        resource_group=$(echo "$resource_id" | grep -oP '(?<=resourceGroups/)[^/]+')
    fi
    
    # Check if Bastion exists
    print_status "Checking for Bastion in resource group: $resource_group"
    local bastion_name
    bastion_name=$(az network bastion list --resource-group "$resource_group" --query "[0].name" -o tsv 2>/dev/null)
    
    if [[ -z "$bastion_name" ]]; then
        print_error "No Bastion found in resource group '$resource_group'"
        print_status "Deploy Bastion first with: $0 create --name <vm_name> --enable-bastion"
        exit 1
    fi
    
    print_success "Found Bastion: $bastion_name"
    
    # Check for existing tunnel
    if [[ -f "$TUNNEL_DIR/${vm_name}.tunnel" ]]; then
        load_tunnel_info "$TUNNEL_DIR/${vm_name}.tunnel"
        if is_tunnel_active "$PID"; then
            print_warning "Existing tunnel found on port $LOCAL_PORT (PID: $PID)"
            read -p "Kill existing tunnel and create new one? (y/N): " -n 1 -r
            echo
            if [[ $REPLY =~ ^[Yy]$ ]]; then
                kill "$PID" 2>/dev/null
                rm -f "$TUNNEL_DIR/${vm_name}.tunnel"
            else
                print_status "Using existing tunnel on port $LOCAL_PORT"
                if [[ "$ssh_after" == true ]]; then
                    print_status "Connecting via SSH..."
                    ssh -p "$LOCAL_PORT" "$DEFAULT_ADMIN_USER@localhost"
                fi
                exit 0
            fi
        else
            rm -f "$TUNNEL_DIR/${vm_name}.tunnel"
        fi
    fi
    
    # Get available port if not specified
    if [[ -z "$local_port" ]]; then
        local_port=$(get_next_port)
    fi
    
    print_status "Creating Bastion tunnel to $vm_name on local port $local_port..."
    
    # Create tunnel with auto-reconnect logic
    if [[ "$auto_reconnect" == true ]]; then
        create_tunnel_with_reconnect "$bastion_name" "$resource_group" "$resource_id" "$local_port" "$vm_name"
    else
        create_tunnel "$bastion_name" "$resource_group" "$resource_id" "$local_port" "$vm_name"
    fi
    
    # SSH after tunnel creation if requested
    if [[ "$ssh_after" == true ]]; then
        print_status "Waiting for tunnel to establish..."
        sleep 3
        
        print_status "Connecting via SSH..."
        ssh -p "$local_port" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$DEFAULT_ADMIN_USER@localhost"
    fi
}

# Create tunnel
create_tunnel() {
    local bastion_name=$1
    local resource_group=$2
    local resource_id=$3
    local local_port=$4
    local vm_name=$5
    
    # Create tunnel in background
    nohup az network bastion tunnel \
        --name "$bastion_name" \
        --resource-group "$resource_group" \
        --target-resource-id "$resource_id" \
        --resource-port 22 \
        --port "$local_port" \
        > "$LOG_DIR/${vm_name}-tunnel.log" 2>&1 &
    
    local pid=$!
    
    # Save tunnel info
    save_tunnel_info "$vm_name" "$resource_group" "$local_port" "$pid"
    
    print_success "Tunnel created on port $local_port (PID: $pid)"
    print_status "Log file: $LOG_DIR/${vm_name}-tunnel.log"
    print_status "SSH command: ssh -p $local_port $DEFAULT_ADMIN_USER@localhost"
}

# Create tunnel with auto-reconnect
create_tunnel_with_reconnect() {
    local bastion_name=$1
    local resource_group=$2
    local resource_id=$3
    local local_port=$4
    local vm_name=$5
    
    # Create monitoring script
    cat > "$TUNNEL_DIR/${vm_name}-monitor.sh" << EOF
#!/bin/bash
MAX_RECONNECT_ATTEMPTS=$MAX_RECONNECT_ATTEMPTS
RECONNECT_DELAY=$RECONNECT_DELAY
LOG_DIR="$LOG_DIR"

bastion_name="$bastion_name"
resource_group="$resource_group"
resource_id="$resource_id"
local_port="$local_port"
vm_name="$vm_name"
attempts=0

echo "Starting auto-reconnect tunnel for \$vm_name on port \$local_port"

while [[ \$attempts -lt \$MAX_RECONNECT_ATTEMPTS ]]; do
    echo "Starting tunnel (attempt \$((attempts+1))/\$MAX_RECONNECT_ATTEMPTS)..."
    
    az network bastion tunnel \
        --name "\$bastion_name" \
        --resource-group "\$resource_group" \
        --target-resource-id "\$resource_id" \
        --resource-port 22 \
        --port "\$local_port" \
        >> "\$LOG_DIR/\${vm_name}-tunnel.log" 2>&1
    
    exit_code=\$?
    
    if [[ \$exit_code -eq 0 ]]; then
        echo "Tunnel disconnected. Reconnecting in \$RECONNECT_DELAY seconds..."
        sleep \$RECONNECT_DELAY
        attempts=0
    else
        ((attempts++))
        if [[ \$attempts -lt \$MAX_RECONNECT_ATTEMPTS ]]; then
            echo "Tunnel failed (exit code: \$exit_code). Retrying in \$RECONNECT_DELAY seconds..."
            sleep \$RECONNECT_DELAY
        else
            echo "Maximum reconnection attempts reached. Giving up."
            exit 1
        fi
    fi
done
EOF
    
    chmod +x "$TUNNEL_DIR/${vm_name}-monitor.sh"
    
    # Start monitor in background
    nohup "$TUNNEL_DIR/${vm_name}-monitor.sh" \
        "$bastion_name" "$resource_group" "$resource_id" "$local_port" "$vm_name" \
        > "$LOG_DIR/${vm_name}-monitor.log" 2>&1 &
    
    local pid=$!
    
    # Save tunnel info
    save_tunnel_info "$vm_name" "$resource_group" "$local_port" "$pid"
    
    print_success "Auto-reconnecting tunnel created on port $local_port (PID: $pid)"
    print_status "Monitor log: $LOG_DIR/${vm_name}-monitor.log"
    print_status "Tunnel log: $LOG_DIR/${vm_name}-tunnel.log"
    print_status "SSH command: ssh -p $local_port $DEFAULT_ADMIN_USER@localhost"
}

# Manage tunnels
manage_tunnels() {
    local action="${1:-list}"
    
    case "$action" in
        list)
            print_status "Active Bastion Tunnels:"
            echo
            printf "%-20s %-15s %-10s %-10s %-25s\n" "VM NAME" "RESOURCE GROUP" "PORT" "PID" "START TIME"
            printf "%-20s %-15s %-10s %-10s %-25s\n" "-------" "--------------" "----" "---" "----------"
            
            for tunnel_file in "$TUNNEL_DIR"/*.tunnel; do
                if [[ -f "$tunnel_file" ]]; then
                    load_tunnel_info "$tunnel_file"
                    if is_tunnel_active "$PID"; then
                        printf "%-20s %-15s %-10s %-10s %-25s\n" "$VM_NAME" "$RESOURCE_GROUP" "$LOCAL_PORT" "$PID" "$START_TIME"
                    else
                        rm -f "$tunnel_file"
                    fi
                fi
            done
            ;;
            
        kill)
            local target="${2:-}"
            if [[ -z "$target" ]]; then
                print_error "Usage: $0 tunnel kill <pid|port|vm_name|all>"
                exit 1
            fi
            
            if [[ "$target" == "all" ]]; then
                print_warning "Killing all tunnels..."
                for tunnel_file in "$TUNNEL_DIR"/*.tunnel; do
                    if [[ -f "$tunnel_file" ]]; then
                        load_tunnel_info "$tunnel_file"
                        if is_tunnel_active "$PID"; then
                            kill "$PID" 2>/dev/null
                            print_success "Killed tunnel for $VM_NAME (PID: $PID)"
                        fi
                        rm -f "$tunnel_file"
                    fi
                done
            elif [[ "$target" =~ ^[0-9]+$ ]]; then
                # Kill by PID or port
                local found=false
                for tunnel_file in "$TUNNEL_DIR"/*.tunnel; do
                    if [[ -f "$tunnel_file" ]]; then
                        load_tunnel_info "$tunnel_file"
                        if [[ "$PID" == "$target" ]] || [[ "$LOCAL_PORT" == "$target" ]]; then
                            if is_tunnel_active "$PID"; then
                                kill "$PID" 2>/dev/null
                                print_success "Killed tunnel for $VM_NAME (PID: $PID, Port: $LOCAL_PORT)"
                                found=true
                            fi
                            rm -f "$tunnel_file"
                        fi
                    fi
                done
                if [[ "$found" == false ]]; then
                    print_error "No active tunnel found with PID or port: $target"
                fi
            else
                # Kill by VM name
                if [[ -f "$TUNNEL_DIR/${target}.tunnel" ]]; then
                    load_tunnel_info "$TUNNEL_DIR/${target}.tunnel"
                    if is_tunnel_active "$PID"; then
                        kill "$PID" 2>/dev/null
                        print_success "Killed tunnel for $target (PID: $PID)"
                    fi
                    rm -f "$TUNNEL_DIR/${target}.tunnel"
                else
                    print_error "No tunnel found for VM: $target"
                fi
            fi
            ;;
            
        status)
            print_status "Tunnel Health Status:"
            echo
            local active_count=0
            local total_count=0
            
            for tunnel_file in "$TUNNEL_DIR"/*.tunnel; do
                if [[ -f "$tunnel_file" ]]; then
                    ((total_count++))
                    load_tunnel_info "$tunnel_file"
                    if is_tunnel_active "$PID"; then
                        ((active_count++))
                        print_success "✓ $VM_NAME (Port: $LOCAL_PORT, PID: $PID) - Active"
                        
                        # Check if port is actually listening
                        if lsof -i :"$LOCAL_PORT" >/dev/null 2>&1; then
                            print_success "  Port $LOCAL_PORT is listening"
                        else
                            print_warning "  Port $LOCAL_PORT is not listening (tunnel may be establishing)"
                        fi
                    else
                        print_error "✗ $VM_NAME - Tunnel dead (cleaning up)"
                        rm -f "$tunnel_file"
                    fi
                fi
            done
            
            echo
            print_status "Summary: $active_count active tunnels out of $total_count total"
            ;;
            
        *)
            print_error "Unknown tunnel action: $action"
            echo "Usage: $0 tunnel [list|kill|status]"
            exit 1
            ;;
    esac
}

# Deploy Bastion to existing VM's resource group
deploy_bastion() {
    check_requirements
    
    local vm_name=""
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --name)
                vm_name="$2"
                shift 2
                ;;
            --help|-h)
                echo "Usage: $0 bastion --name <vm_name>"
                echo "Deploy Azure Bastion to enable secure access to existing VM"
                exit 0
                ;;
            *)
                print_error "Unknown option: $1"
                exit 1
                ;;
        esac
    done
    
    # Interactive selection if no name provided
    if [[ -z "$vm_name" ]]; then
        local vm_info
        vm_info=$(az vm list -d --query "[].{Name:name,ResourceGroup:resourceGroup,State:powerState}" -o json | \
                  jq -r '.[] | "\(.Name) \(.ResourceGroup) \(.State)"' | \
                  fzf --prompt="Select VM for Bastion deployment: " --header="NAME RESOURCE_GROUP STATE")
        
        if [[ -n "$vm_info" ]]; then
            vm_name=$(echo "$vm_info" | awk '{print $1}')
        else
            print_error "No VM selected"
            exit 1
        fi
    fi
    
    # Get resource group
    local resource_group
    resource_group=$(az vm list --query "[?name=='$vm_name'].resourceGroup | [0]" -o tsv 2>/dev/null)
    
    if [[ -z "$resource_group" ]]; then
        print_error "VM '$vm_name' not found"
        exit 1
    fi
    
    print_status "Deploying Bastion for VM: $vm_name in resource group: $resource_group"
    
    # Check if Bastion already exists
    local existing_bastion
    existing_bastion=$(az network bastion list --resource-group "$resource_group" --query "[0].name" -o tsv 2>/dev/null)
    
    if [[ -n "$existing_bastion" ]]; then
        print_warning "Bastion already exists: $existing_bastion"
        print_status "You can connect using: $0 connect --name $vm_name"
        exit 0
    fi
    
    # Get VNet name
    print_status "Finding VNet for the VM..."
    local vnet_name
    vnet_name=$(az network vnet list -g "$resource_group" --query "[0].name" -o tsv)
    
    if [[ -z "$vnet_name" ]]; then
        print_error "No VNet found in resource group"
        exit 1
    fi
    
    print_success "Found VNet: $vnet_name"
    
    # Get VNet address space to determine Bastion subnet
    local vnet_prefix
    vnet_prefix=$(az network vnet show -g "$resource_group" -n "$vnet_name" --query "addressSpace.addressPrefixes[0]" -o tsv | cut -d'.' -f1-2)
    local bastion_subnet="${vnet_prefix}.254.0/26"
    
    # Create AzureBastionSubnet
    print_status "Creating AzureBastionSubnet with address space: $bastion_subnet"
    az network vnet subnet create \
        --resource-group "$resource_group" \
        --vnet-name "$vnet_name" \
        --name "AzureBastionSubnet" \
        --address-prefixes "$bastion_subnet" \
        --output none 2>/dev/null || {
        print_warning "AzureBastionSubnet already exists or address conflict"
        print_status "Trying alternative address space..."
        bastion_subnet="${vnet_prefix}.250.0/26"
        az network vnet subnet create \
            --resource-group "$resource_group" \
            --vnet-name "$vnet_name" \
            --name "AzureBastionSubnet" \
            --address-prefixes "$bastion_subnet" \
            --output none || {
            print_error "Failed to create AzureBastionSubnet. Please check VNet address space."
            exit 1
        }
    }
    
    # Create public IP
    local bastion_name="${resource_group}-bastion"
    print_status "Creating public IP for Bastion..."
    az network public-ip create \
        --resource-group "$resource_group" \
        --name "${bastion_name}-pip" \
        --sku Standard \
        --allocation-method Static \
        --output none
    
    # Deploy Bastion
    print_status "Deploying Azure Bastion (this will take 5-10 minutes)..."
    print_warning "Do not interrupt this process"
    
    az network bastion create \
        --name "$bastion_name" \
        --resource-group "$resource_group" \
        --vnet-name "$vnet_name" \
        --public-ip-address "${bastion_name}-pip" \
        --sku Standard \
        --enable-tunneling true \
        --enable-ip-connect true \
        --output none
    
    print_success "Bastion deployed successfully!"
    print_status "Bastion name: $bastion_name"
    print_status "You can now connect using: $0 connect --name $vm_name"
    
    # Show deployment details
    print_status "\nBastion Details:"
    az network bastion show \
        --name "$bastion_name" \
        --resource-group "$resource_group" \
        --query "{Name:name,Status:provisioningState,SKU:sku.name,Location:location}" \
        -o table
}

# Check for required tools
check_requirements() {
    local missing_tools=()
    
    for cmd in az jq fzf; do
        if ! command -v "$cmd" &> /dev/null; then
            missing_tools+=("$cmd")
        fi
    done
    
    if [[ ${#missing_tools[@]} -gt 0 ]]; then
        print_error "Missing required tools: ${missing_tools[*]}"
        print_status "Please install the missing tools and try again."
        exit 1
    fi
    
    # Check Azure login
    if ! az account show >/dev/null 2>&1; then
        print_error "Not logged into Azure. Please run: az login"
        exit 1
    fi
}

# Main script
case "${1:-}" in
    create)
        shift
        create_vm "$@"
        ;;
    delete)
        shift
        delete_vm "$@"
        ;;
    list)
        shift
        list_vms "$@"
        ;;
    status)
        shift
        vm_status "$@"
        ;;
    start)
        shift
        start_vm "$@"
        ;;
    stop)
        shift
        stop_vm "$@"
        ;;
    connect)
        shift
        connect_bastion "$@"
        ;;
    tunnel)
        shift
        manage_tunnels "$@"
        ;;
    bastion)
        shift
        deploy_bastion "$@"
        ;;
    --help|-h)
        show_help
        ;;
    *)
        print_error "Unknown command: ${1:-}"
        show_help
        exit 1
        ;;
esac