#!/bin/bash
#
# azvm-vscode - Connect VS Code to Azure VM via Bastion
#

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

# Configuration
SSH_CONFIG_FILE="$HOME/.ssh/config"
VSCODE_SSH_CONFIG="$HOME/.ssh/vscode-bastion-config"

print_status() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

show_help() {
    cat << EOF
Connect VS Code to Azure VM via Bastion

Usage: $0 [VM_NAME] [OPTIONS]

Options:
    --port PORT     Local port for tunnel (default: auto-assign 2300-2399)
    --add-config    Add SSH config entry for VS Code
    --help          Show this help

Examples:
    $0 myvm                    # Setup tunnel and show connection info
    $0 myvm --add-config       # Setup tunnel and add to SSH config
    $0 myvm --port 2345        # Use specific port

After running this script:
1. Open VS Code
2. Use Remote-SSH extension
3. Connect to host: [VM_NAME]-bastion
EOF
}

# Parse arguments
VM_NAME=""
LOCAL_PORT=""
ADD_CONFIG=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --port)
            LOCAL_PORT="$2"
            shift 2
            ;;
        --add-config)
            ADD_CONFIG=true
            shift
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        *)
            VM_NAME="$1"
            shift
            ;;
    esac
done

if [[ -z "$VM_NAME" ]]; then
    print_error "VM name required"
    show_help
    exit 1
fi

# Find available port if not specified
if [[ -z "$LOCAL_PORT" ]]; then
    for port in {2300..2399}; do
        if ! lsof -i :$port >/dev/null 2>&1; then
            LOCAL_PORT=$port
            break
        fi
    done
fi

print_status "Setting up VS Code connection to $VM_NAME via Bastion..."

# Check if tunnel already exists
TUNNEL_INFO="$HOME/.azure/bastion-tunnels/${VM_NAME}.tunnel"
if [[ -f "$TUNNEL_INFO" ]]; then
    source "$TUNNEL_INFO"
    if kill -0 "$PID" 2>/dev/null; then
        print_success "Existing tunnel found on port $LOCAL_PORT"
    else
        rm -f "$TUNNEL_INFO"
        print_status "Creating new tunnel..."
        ~/bin/azvm-working connect --name "$VM_NAME" --port "$LOCAL_PORT" --no-ssh &
        sleep 5
    fi
else
    print_status "Creating Bastion tunnel on port $LOCAL_PORT..."
    ~/bin/azvm-working connect --name "$VM_NAME" --port "$LOCAL_PORT" --no-ssh &
    sleep 5
fi

# Get connection details
print_success "Tunnel ready on port $LOCAL_PORT"

# SSH config entry
SSH_CONFIG_ENTRY="
Host ${VM_NAME}-bastion
    HostName localhost
    Port $LOCAL_PORT
    User setuc
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR
"

if [[ "$ADD_CONFIG" == true ]]; then
    # Check if entry already exists
    if grep -q "Host ${VM_NAME}-bastion" "$SSH_CONFIG_FILE" 2>/dev/null; then
        print_status "Updating existing SSH config entry..."
        # Remove old entry
        sed -i "/Host ${VM_NAME}-bastion/,/^$/d" "$SSH_CONFIG_FILE"
    fi
    
    # Add new entry
    echo "$SSH_CONFIG_ENTRY" >> "$SSH_CONFIG_FILE"
    print_success "Added to SSH config"
fi

# Show connection instructions
echo
print_success "VS Code Setup Complete!"
echo
echo "Method 1 - Quick Connect:"
echo "  1. Open VS Code"
echo "  2. Press Ctrl+Shift+P (Cmd+Shift+P on Mac)"
echo "  3. Type: Remote-SSH: Connect to Host..."
echo "  4. Enter: setuc@localhost -p $LOCAL_PORT"
echo
echo "Method 2 - SSH Config (Recommended):"
if [[ "$ADD_CONFIG" != true ]]; then
    echo "  1. Add this to ~/.ssh/config:"
    echo "$SSH_CONFIG_ENTRY"
    echo "  2. In VS Code: Remote-SSH: Connect to Host..."
    echo "  3. Select: ${VM_NAME}-bastion"
else
    echo "  1. In VS Code: Remote-SSH: Connect to Host..."
    echo "  2. Select: ${VM_NAME}-bastion"
fi
echo
echo "To manage tunnel:"
echo "  View status: ~/bin/azvm-working tunnel status"
echo "  Kill tunnel: ~/bin/azvm-working tunnel kill $LOCAL_PORT"