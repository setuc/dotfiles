<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Azure VM Report - {{ report_data.vm_name }}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            background-color: #f4f4f4;
        }
        .container {
            background-color: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        h1, h2 {
            color: #0078d4;
        }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin: 20px 0;
        }
        .info-card {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            border-left: 4px solid #0078d4;
        }
        .security-check {
            margin: 10px 0;
            padding: 10px;
            border-radius: 5px;
        }
        .pass {
            background-color: #d4edda;
            color: #155724;
            border-left: 4px solid #28a745;
        }
        .fail {
            background-color: #f8d7da;
            color: #721c24;
            border-left: 4px solid #dc3545;
        }
        .cost-table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }
        .cost-table th, .cost-table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }
        .cost-table th {
            background-color: #0078d4;
            color: white;
        }
        .tag {
            display: inline-block;
            padding: 4px 8px;
            margin: 2px;
            background-color: #e7f3ff;
            border-radius: 3px;
            font-size: 0.9em;
        }
        .timestamp {
            text-align: right;
            color: #666;
            font-size: 0.9em;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Azure VM Report: {{ report_data.vm_name }}</h1>
        <p class="timestamp">Generated: {{ ansible_date_time.iso8601 }}</p>
        
        <div class="info-grid">
            <div class="info-card">
                <h3>Basic Information</h3>
                <p><strong>VM Name:</strong> {{ report_data.vm_name }}</p>
                <p><strong>Resource Group:</strong> {{ report_data.resource_group }}</p>
                <p><strong>Region:</strong> {{ report_data.region }}</p>
                <p><strong>Size:</strong> {{ report_data.vm_size }}</p>
                <p><strong>Power State:</strong> {{ report_data.power_state }}</p>
                <p><strong>OS Type:</strong> {{ report_data.os_type }}</p>
            </div>
            
            <div class="info-card">
                <h3>Network Configuration</h3>
                <p><strong>Public IP:</strong> {{ report_data.public_ip }}</p>
                <p><strong>Private IP:</strong> {{ report_data.private_ip }}</p>
                <p><strong>Admin User:</strong> {{ report_data.admin_user }}</p>
                <p><strong>NSG Rules:</strong> {{ report_data.nsg_rules_count }}</p>
                <p><strong>Allowed SSH IPs:</strong></p>
                <ul>
                {% for ip in report_data.allowed_ips %}
                    <li>{{ ip }}</li>
                {% else %}
                    <li>No IPs configured</li>
                {% endfor %}
                </ul>
            </div>
        </div>
        
        <h2>Security Compliance</h2>
        <div class="security-checks">
            <div class="security-check {{ 'pass' if report_data.security.ssh_restricted else 'fail' }}">
                <strong>SSH Access Restricted:</strong> {{ 'PASS' if report_data.security.ssh_restricted else 'FAIL' }}
            </div>
            <div class="security-check {{ 'pass' if report_data.security.public_ip_secured else 'fail' }}">
                <strong>No Unrestricted Public Access:</strong> {{ 'PASS' if report_data.security.public_ip_secured else 'FAIL' }}
            </div>
            <div class="security-check {{ 'pass' if report_data.security.managed_identity_enabled else 'fail' }}">
                <strong>Managed Identity Enabled:</strong> {{ 'PASS' if report_data.security.managed_identity_enabled else 'FAIL' }}
            </div>
            <div class="security-check {{ 'pass' if report_data.security.boot_diagnostics_enabled else 'fail' }}">
                <strong>Boot Diagnostics Enabled:</strong> {{ 'PASS' if report_data.security.boot_diagnostics_enabled else 'FAIL' }}
            </div>
            <div class="security-check {{ 'pass' if report_data.security.disk_encryption else 'fail' }}">
                <strong>Disk Encryption:</strong> {{ 'PASS' if report_data.security.disk_encryption else 'FAIL' }}
            </div>
        </div>
        
        <h2>Cost Estimates</h2>
        <table class="cost-table">
            <thead>
                <tr>
                    <th>Period</th>
                    <th>Estimated Cost (USD)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Hourly</td>
                    <td>${{ report_data.costs.hourly | default('N/A') }}</td>
                </tr>
                <tr>
                    <td>Daily</td>
                    <td>${{ report_data.costs.daily | default('N/A') }}</td>
                </tr>
                <tr>
                    <td>Monthly</td>
                    <td>${{ report_data.costs.monthly | default('N/A') }}</td>
                </tr>
                <tr>
                    <td>Yearly</td>
                    <td>${{ report_data.costs.yearly | default('N/A') }}</td>
                </tr>
            </tbody>
        </table>
        
        {% if report_data.backup_status %}
        <h2>Backup Status</h2>
        <div class="info-card">
            <p><strong>Protection Status:</strong> {{ report_data.backup_status.status | default('Not configured') }}</p>
            <p><strong>Last Backup:</strong> {{ report_data.backup_status.lastBackup | default('N/A') }}</p>
        </div>
        {% endif %}
        
        <h2>Resource Tags</h2>
        <div>
            {% for key, value in report_data.tags.items() %}
            <span class="tag">{{ key }}: {{ value }}</span>
            {% else %}
            <p>No tags configured</p>
            {% endfor %}
        </div>
    </div>
</body>
</html>